# ===== community 环境变量模板 =====
# 用法：cp .env.example .env
#   .env 已被 .gitignore 忽略，不会入库；真实值只留在你本机。
# 注意：docker compose 会自动读取项目目录下的 .env；
#       mvn spring-boot:run 不会读 .env，请用  VAR=value mvn spring-boot:run  或先 export。

# ---- MySQL ----
# 应用连接数据库（application.yml 里的默认值）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=community
DB_USER=root
# 应用连库密码：
#   用 docker compose 起的 MySQL → 填 root（与下方 MYSQL_ROOT_PASSWORD 一致）
#   连本机已有的 MySQL       → 填本机 root 密码（很多环境是空）
DB_PASSWORD=

# docker compose 里 MySQL 容器的 root 密码（首次初始化时生效）
MYSQL_ROOT_PASSWORD=root
# compose 把 MySQL 映射到宿主机的端口（本机 3306 被占用时改这里）
MYSQL_PORT=3306

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# HS256 密钥，必须 ≥32 字节。留空则每次启动随机生成一把，重启后已签发的 token 全部失效。
# 生成方式：openssl rand -base64 32
JWT_SECRET=
